<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BE.CQRS.Di.AspCore</RootNamespace>
    <AssemblyName>BE.CQRS.Di.AspCore</AssemblyName>
    <PackageId>BE.CQRS.Di.AspCore</PackageId>
    <PackageProjectUrl>https://github.com/BoasE/BE.CQRS</PackageProjectUrl>
    <PackageReleaseNotes>.net 10</PackageReleaseNotes>
    <PackageVersion>0.100.0-alpha</PackageVersion>
    <PackageTags>.net,c#,cqrs,eventsourcing,framework</PackageTags>
    <RepositoryUrl>https://github.com/BoasE/BE.CQRS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <LangVersion>14.0</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>BoasE</Authors>
    <Company>BoasE</Company>
    <Description>ASP.NET Core DI helpers for BE.CQRS to wire domain and event sourcing services.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\Domain\Domain.csproj" />
  </ItemGroup>

</Project>