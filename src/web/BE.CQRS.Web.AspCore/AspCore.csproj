<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>BE.CQRS.Web.AspCore</PackageId>
        <PackageProjectUrl>https://github.com/BoasE/BE.CQRS</PackageProjectUrl>
        <PackageReleaseNotes>.net 10</PackageReleaseNotes>
        <PackageVersion>0.100.0-alpha</PackageVersion>
        <PackageTags>.net,c#,cqrs,eventsourcing,framework</PackageTags>
        <RepositoryUrl>https://github.com/BoasE/BE.CQRS</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <LangVersion>14.0</LangVersion>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>BoasE</Authors>
        <Company>BoasE</Company>
        <Description>ASP.NET Core adapters for BE.CQRS web APIs and controllers.</Description>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageReference Include="BE.CQRS.Domain" Version="0.100.0-alpha" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Domain\Domain\Domain.csproj" />
    </ItemGroup>

</Project>